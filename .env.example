# =====================================================
# APPLICATION
# =====================================================

APP_NAME=Agentic Threat Intelligence Platform
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# =====================================================
# SECURITY
# =====================================================

SECRET_KEY=change_this_to_a_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================================
# POSTGRESQL DATABASE
# =====================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threat_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/threat_intelligence

# =====================================================
# QDRANT VECTOR DATABASE
# =====================================================

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=threat_documents
QDRANT_API_KEY=

# =====================================================
# EMBEDDING MODEL
# =====================================================

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# =====================================================
# LLM PROVIDER
# Choose ONE provider
# =====================================================

LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# =====================================================
# THREAT INTELLIGENCE SOURCES
# =====================================================

NVD_API_KEY=
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
EPSS_API_URL=https://api.first.org/data/v1/epss
GITHUB_ADVISORY_API=https://api.github.com/advisories

# =====================================================
# FILE STORAGE
# =====================================================

DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
REPORT_DIR=./data/reports

# =====================================================
# LOGGING
# =====================================================

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =====================================================
# CACHE
# =====================================================

CACHE_TTL=3600

# =====================================================
# CORS
# =====================================================

CORS_ORIGINS=http://localhost:3000

# =====================================================
# ORGANIZATION ASSET UPLOAD
# =====================================================

MAX_UPLOAD_SIZE_MB=20
UPLOAD_FOLDER=uploads

# =====================================================
# REPORT GENERATION
# =====================================================

REPORT_TEMPLATE=default

# =====================================================
# SCHEDULER
# =====================================================

THREAT_SYNC_INTERVAL_HOURS=6